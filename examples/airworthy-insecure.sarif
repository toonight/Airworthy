                  "OWASP-ASI03"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-SEC-003",
              "name": "AzureStorageAccountKeyInAConnectionString",
              "shortDescription": {
                "text": "Azure Storage account key in a connection string"
              },
              "fullDescription": {
                "text": "An Azure Storage connection string with AccountKey= is written in a configuration or instruction file. The account key gives full access to the storage account."
              },
              "help": {
                "text": "Revoke the storage account key and issue a new one, remove it from the file and from the Git history, and load it at run time instead: an input variable in .vscode/mcp.json (${input:...} with \"password\": true), or an environment variable set outside the repository."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/customization/mcp-servers",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "secrets",
