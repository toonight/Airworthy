                  "OWASP-ASI03"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-SEC-004",
              "name": "OpenAIStyleAPIKeyInAConfigurationFile",
              "shortDescription": {
                "text": "OpenAI-style API key in a configuration file"
              },
              "fullDescription": {
                "text": "A key in the sk- format of OpenAI (sk-, sk-proj-, sk-svcacct-, sk-admin-) is written in a configuration or instruction file. Other model providers use the same prefix, so check which service issued it."
              },
              "help": {
                "text": "Revoke the API key and issue a new one, remove it from the file and from the Git history, and load it at run time instead: an input variable in .vscode/mcp.json (${input:...} with \"password\": true), or an environment variable set outside the repository."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/customization/mcp-servers",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "secrets",
                  "generic",
                  "OWASP-ASI03"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-SEC-005",
              "name": "AnthropicAPIKeyInAConfigurationFile",
              "shortDescription": {
                "text": "Anthropic API key in a configuration file"
              },
              "fullDescription": {
                "text": "An Anthropic key (sk-ant- prefix) is written in a configuration or instruction file. It allows API calls billed to the account that owns it."
              },
              "help": {
                "text": "Revoke the Anthropic API key and issue a new one, remove it from the file and from the Git history, and load it at run time instead: an input variable in .vscode/mcp.json (${input:...} with \"password\": true), or an environment variable set outside the repository."
              },
              "helpUri": "https://code.claude.com/docs/en/settings",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "secrets",
                  "generic",
                  "OWASP-ASI03"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-SEC-006",
              "name": "SlackTokenInAConfigurationFile",
              "shortDescription": {
                "text": "Slack token in a configuration file"
              },
              "fullDescription": {
                "text": "A Slack token (xoxb-, xoxp-, xoxa-, xoxr- or xoxs- prefix) is written in a configuration or instruction file. It can read and post messages as the bot or user that owns it."
              },
              "help": {
                "text": "Revoke the Slack token and issue a new one, remove it from the file and from the Git history, and load it at run time instead: an input variable in .vscode/mcp.json (${input:...} with \"password\": true), or an environment variable set outside the repository."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/customization/mcp-servers",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "secrets",
