                  "OWASP-ASI03"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-SEC-007",
              "name": "PrivateKeyInAConfigurationFile",
              "shortDescription": {
                "text": "Private key in a configuration file"
              },
              "fullDescription": {
                "text": "A private key block (-----BEGIN ... PRIVATE KEY-----) is stored in a configuration or instruction file that agents and tools can read."
              },
              "help": {
                "text": "Revoke the private key and issue a new one, remove it from the file and from the Git history, and load it at run time instead: an input variable in .vscode/mcp.json (${input:...} with \"password\": true), or an environment variable set outside the repository."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "secrets",
                  "generic",
                  "OWASP-ASI03"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-SEC-008",
              "name": "JSONWebTokenInAConfigurationFile",
              "shortDescription": {
                "text": "JSON Web Token in a configuration file"
              },
              "fullDescription": {
                "text": "A JSON Web Token (three dot-separated encoded parts, the first two starting with eyJ) is written in a configuration or instruction file. It is a bearer token: whoever holds it is authenticated until it expires."
              },
              "help": {
                "text": "Revoke the token and issue a new one, remove it from the file and from the Git history, and load it at run time instead: an input variable in .vscode/mcp.json (${input:...} with \"password\": true), or an environment variable set outside the repository."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/customization/mcp-servers",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "secrets",
                  "generic",
                  "OWASP-ASI03"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            },
            {
              "id": "AW-SEC-009",
              "name": "HardCodedPasswordSecretOrTokenValue",
              "shortDescription": {
                "text": "Hard-coded password, secret or token value"
              },
              "fullDescription": {
                "text": "A key whose name contains password, passwd, secret, token or api key is assigned a literal value. Placeholders, references (${input:...}, $VAR, %VAR%), paths, URLs, numbers, booleans and low-entropy values (under 3 bits per character or fewer than 6 distinct characters) are ignored, and so are the values of the env_http_headers, bearer_token_env_var and env_vars keys of Codex MCP servers, which name environment variables (unless the value is not a valid variable name or also appears elsewhere in the file). The remaining matches may still include false positives."
              },
              "help": {
                "text": "Revoke the secret and issue a new one, remove it from the file and from the Git history, and load it at run time instead: an input variable in .vscode/mcp.json (${input:...} with \"password\": true), or an environment variable set outside the repository."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/customization/mcp-servers",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "secrets",
                  "generic",
                  "OWASP-ASI03"
                ],
                "security-severity": "5.5",
                "precision": "medium"
              }
            },
            {
              "id": "AW-SEC-010",
              "name": "EnvironmentFileInTheWorkspace",
              "shortDescription": {
                "text": "Environment file in the workspace"
              },
              "fullDescription": {
                "text": "A .env file sits at the root of the analyzed folder. Such files usually hold secrets, and agents with file-read or terminal tools can read them, then send their content to the model or to a tool. Template files (.env.example, .sample, .template, .dist, .defaults, .schema) are ignored."
              },
              "help": {
                "text": "Keep secrets out of the workspace (secret store, prompted inputs). If the file must stay, keep it out of Git (.gitignore) and deny agents access to it, for example with permissions.deny Read(./.env) and Read(./.env.*) in Claude Code settings."
              },
              "helpUri": "https://code.claude.com/docs/en/settings",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "secrets",
                  "generic",
                  "OWASP-ASI03"
                ],
                "security-severity": "3.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-001",
              "name": "GlobalAutoApprovalOfToolsEnabled",
              "shortDescription": {
                "text": "Global auto-approval of tools enabled"
              },
              "fullDescription": {
                "text": "chat.tools.global.autoApprove = true auto-approves every tool call (terminal, file edits, MCP tools, URL fetches) in every workspace, so an instruction injected through a file, a web page or a tool output runs with no human in the loop. The settings reference warns that it disables critical security protections."
              },
              "help": {
                "text": "Set \"chat.tools.global.autoApprove\": false. In managed environments, deploy the ChatToolsAutoApprove policy so that it cannot be turned back on."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI02",
                  "OWASP-ASI01"
                ],
                "security-severity": "9.5",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-002",
              "name": "DefaultPermissionLevelSkipsApprovals",
              "shortDescription": {
                "text": "Default permission level skips approvals"
              },
              "fullDescription": {
                "text": "chat.permissions.default sets the permission level of new chat sessions. \"autoApprove\" (Allow all) runs every tool call without confirmation; \"autopilot\" also auto-approves all tools and keeps retrying on errors. Confidence is medium: the value is only the default of new sessions (users can change it per session and an enterprise policy can force Manual permissions), and how it combines with the Copilot harness permissions object is not fully documented."
              },
              "help": {
                "text": "Set \"chat.permissions.default\": \"default\" (Manual permissions). The ChatToolsAutoApprove policy (false) hides Allow all and Assisted permissions."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI02"
                ],
                "security-severity": "8.0",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-003",
              "name": "TerminalCommandAutoApprovalEnabled",
              "shortDescription": {
                "text": "Terminal command auto-approval enabled"
              },
              "fullDescription": {
                "text": "chat.tools.terminal.enableAutoApprove = true (the default) runs terminal commands that match an allow rule without confirmation. The documentation calls command matching best effort, with known limits on shell aliases, quote concatenation and complex shell syntax. Severity is critical when a catch-all allow rule exists, or when Airworthy runs on Windows and chat.agent.sandbox.enabled is not \"on\": Windows sandboxing is Experimental and Local harness terminal commands are not sandboxed there, so a parser bypass runs with your full rights. Airworthy assumes the agent runs on the scanned machine."
              },
              "help": {
                "text": "For sensitive agents set \"chat.tools.terminal.enableAutoApprove\": false (policy ChatToolsTerminalEnableAutoApprove). Otherwise keep only narrow read-only allow rules and turn on the agent sandbox (\"chat.agent.sandbox.enabled\": \"on\")."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI05",
                  "OWASP-ASI02"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-004",
              "name": "CatchAllOrBroadTerminalAllowRule",
              "shortDescription": {
                "text": "Catch-all or broad terminal allow rule"
              },
              "fullDescription": {
                "text": "A regex rule set to true in chat.tools.terminal.autoApprove matches any command (for example \"/.*/\"), so every command without a false rule is auto-approved (critical). A broad regex that matches three or more interpreters, downloaders or publishing commands has nearly the same effect (high). Airworthy tests each rule against synthetic command lines with .NET regex; a JavaScript-only regex feature makes the rule count as non-matching. Reported only while terminal auto-approval is on."
              },
              "help": {
                "text": "Remove catch-all and broad regexes. Allow only exact read-only commands, for example \"/^git (status|diff|log)\\\\b/\": true."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI05",
                  "OWASP-ASI02"
                ],
                "security-severity": "9.5",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-005",
              "name": "RiskyCommandAutoApprovedInTheTerminal",
              "shortDescription": {
                "text": "Risky command auto-approved in the terminal"
              },
              "fullDescription": {
                "text": "An allow rule (true) in chat.tools.terminal.autoApprove matches a command that can download, execute or publish code: powershell (encoded command), pwsh (encoded command), iwr, Invoke-WebRequest, irm, Invoke-RestMethod, Start-BitsTransfer, curl.exe, curl, wget, certutil, bitsadmin, python -c, node -e, npx, git push, rm -rf, Remove-Item. One injected instruction can then exfiltrate data or run a payload with no approval. A false rule matching the same command takes precedence, as documented, and suppresses the finding. Reported only while terminal auto-approval is on; catch-all and broad rules are reported by AW-VSC-004."
              },
              "help": {
                "text": "Remove the allow rule, or set the command to false so that it always requires approval (for example \"npx\": false, \"git push\": false)."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI05",
                  "OWASP-ASI02"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-006",
              "name": "WindowsExfiltrationCommandsLackApprovalRequiredRules",
              "shortDescription": {
                "text": "Windows exfiltration commands lack approval-required rules"
              },
              "fullDescription": {
                "text": "While terminal auto-approval is on, the built-in approval-required rules cover only rm, rmdir, del, kill, curl, wget, eval, chmod, chown and Remove-Item. Windows download and exfiltration commands (iwr, Invoke-WebRequest, irm, Invoke-RestMethod, Start-BitsTransfer, curl.exe, certutil, bitsadmin, powershell (encoded command), pwsh (encoded command)) have no false entry, so any allow rule that matches them approves them silently. A false entry only FORCES APPROVAL: it does not block the command; only a PreToolUse hook that returns \"deny\" blocks it. Severity is low with built-in allow rules only, medium when custom allow rules exist. Confidence is medium: whether the built-in \"curl\" rule also matches curl.exe, and whether plain command names match case-insensitively, is not documented."
              },
              "help": {
                "text": "Add approval-required entries to chat.tools.terminal.autoApprove: \"iwr\": false, \"Invoke-WebRequest\": false, \"irm\": false, \"Invoke-RestMethod\": false, \"Start-BitsTransfer\": false, \"curl.exe\": false, \"certutil\": false, \"bitsadmin\": false, \"/^(powershell|pwsh)(\\\\.exe)?\\\\b/i\": false. To block a command, add a PreToolUse hook that returns permissionDecision \"deny\"."
              },
              "helpUri": "https://code.visualstudio.com/docs/agents/run/approvals",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI05",
                  "OWASP-ASI02"
                ],
                "security-severity": "5.5",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-007",
              "name": "BuiltInTerminalApprovalRulesIgnored",
              "shortDescription": {
                "text": "Built-in terminal approval rules ignored"
              },
              "fullDescription": {
                "text": "chat.tools.terminal.ignoreDefaultAutoApproveRules = true drops the built-in rules, including the approval-required rules for rm, del, curl, wget, eval and Remove-Item, which the documentation says are designed to protect against dangerous commands. Reported only while terminal auto-approval is on."
              },
              "help": {
                "text": "Set \"chat.tools.terminal.ignoreDefaultAutoApproveRules\": false."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI05"
                ],
                "security-severity": "8.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-008",
              "name": "TerminalPromptsAnsweredAutomatically",
              "shortDescription": {
                "text": "Terminal prompts answered automatically"
              },
              "fullDescription": {
                "text": "chat.tools.terminal.autoReplyToPrompts = true answers interactive terminal prompts (confirmations, overwrite or install questions) with a default reply, which removes a last-chance confirmation from commands the agent runs."
              },
              "help": {
                "text": "Set \"chat.tools.terminal.autoReplyToPrompts\": false."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI09",
                  "OWASP-ASI02"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-009",
              "name": "EditAutoApprovalCoversAgentControlFiles",
              "shortDescription": {
                "text": "Edit auto-approval covers agent control files"
              },
              "fullDescription": {
                "text": "A true pattern in chat.tools.edits.autoApprove lets the agent edit matching files without approval. When it covers control files (.vscode settings and tasks, mcp.json, agent, instruction and prompt files, .github/workflows, .github/hooks, .git, .env*), an injected instruction can grant itself more rights or plant code that runs later: the CVE-2025-53773 class of attack (high). A broad pattern such as \"**\" or \"**/*\" whose control files all have a false entry still auto-approves build and hook scripts (medium). Confidence is medium: the documentation does not say how overlapping patterns are resolved (Airworthy assumes a false pattern wins, as in the documented example) or whether patterns match the full workspace-relative path."
              },
              "help": {
                "text": "Remove broad true patterns and add false entries for control files: \"**/.vscode/**\", \"**/*.agent.md\", \"**/.github/agents/**\", \"**/.github/copilot-instructions.md\", \"**/.github/instructions/**\", \"**/.github/prompts/**\", \"**/.github/workflows/**\", \"**/.github/hooks/**\", \"**/.git/**\", \"**/mcp.json\", \"**/.mcp.json\" and \"**/.env*\" set to false."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/chat/review-code-edits",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI03",
                  "OWASP-ASI06"
                ],
                "security-severity": "8.0",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-010",
              "name": "WildcardURLAutoApproval",
              "shortDescription": {
                "text": "Wildcard URL auto-approval"
              },
              "fullDescription": {
                "text": "Wildcard entries in chat.tools.urls.autoApprove approve fetch requests, responses, or both, without review. An any-host wildcard (\"*\", \"https://*\", \"*.com\") lets an injected instruction send data to any server and feeds untrusted pages to the model (high); a subdomain wildcard (medium) or a path wildcard on one host (low) extends trust to content that other people may control. Confidence is medium: the exact wildcard matching rules are not fully documented."
              },
              "help": {
                "text": "List exact URLs only. Prefer {\"approveRequest\": true, \"approveResponse\": false} so that fetched content is still reviewed, and remove \"*\", \"https://*\" and top-level-domain wildcards."
              },
              "helpUri": "https://code.visualstudio.com/docs/agents/run/approvals",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "sandbox-network",
                  "vscode-copilot",
                  "OWASP-ASI01",
                  "OWASP-ASI02"
                ],
                "security-severity": "8.0",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-011",
              "name": "TerminalRiskAssessmentDisabled",
              "shortDescription": {
                "text": "Terminal risk assessment disabled"
              },
              "fullDescription": {
                "text": "chat.tools.riskAssessment.enabled = false removes the AI-generated risk badge from terminal command confirmations. The badge helps the person who approves, but it is NOT a security boundary (model-based risk assessments can make mistakes), hence the low severity."
              },
              "help": {
                "text": "Set \"chat.tools.riskAssessment.enabled\": true, and keep human approval as the real control."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI09"
                ],
                "security-severity": "3.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-012",
              "name": "AgentSandboxDisabled",
              "shortDescription": {
                "text": "Agent sandbox disabled"
              },
              "fullDescription": {
                "text": "chat.agent.sandbox.enabled is not \"on\" (the documented default is \"off\"), so terminal commands and the MCP and language servers started by the agent run with your full user rights, file system and network. Confidence is medium: the security page says Copilot harness sessions are sandboxed by default while the settings and sandboxing pages document \"off\"; Windows support is Experimental and Local harness sessions use a different sandbox. Even when on, the sandbox is not a VM or a user-account boundary."
              },
              "help": {
                "text": "Set \"chat.agent.sandbox.enabled\": \"on\" (Copilot harness), or require it with Copilot managed settings. On Windows, prefer a dev container or WSL2 for agent work."
              },
              "helpUri": "https://code.visualstudio.com/docs/agents/run/agent-sandboxing",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "sandbox-network",
                  "vscode-copilot",
                  "OWASP-ASI05",
                  "OWASP-ASI03"
                ],
                "security-severity": "8.0",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-013",
              "name": "UnrestrictedNetworkEgress",
              "shortDescription": {
                "text": "Unrestricted network egress"
              },
              "fullDescription": {
                "text": "chat.agent.sandbox.network.allowNetwork = true (default) with no chat.agent.sandbox.network.allowedDomains, and chat.agent.networkFilter off with no chat.agent.allowedNetworkDomains: sandboxed commands, the fetch tool and the integrated browser can reach any host, the usual exfiltration path of prompt-injection attacks. Confidence is medium: the documentation does not say whether a non-empty allowedDomains blocks every other destination (check with /sandbox policy)."
              },
              "help": {
                "text": "Set \"chat.agent.sandbox.network.allowNetwork\": false, or keep it true with a narrow \"chat.agent.sandbox.network.allowedDomains\" list; also set \"chat.agent.networkFilter\": true with a narrow \"chat.agent.allowedNetworkDomains\"."
              },
              "helpUri": "https://code.visualstudio.com/docs/agents/run/agent-sandboxing",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "sandbox-network",
                  "vscode-copilot",
                  "OWASP-ASI02",
                  "OWASP-ASI05"
                ],
                "security-severity": "5.5",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-014",
              "name": "CommandsMayLeaveTheSandbox",
              "shortDescription": {
                "text": "Commands may leave the sandbox"
              },
              "fullDescription": {
                "text": "chat.agent.sandbox.allowUnsandboxedCommands = true (default) lets the agent ask to run a blocked command outside the sandbox; after one approval (or one for the whole session) the command runs with your full rights. Approval fatigue and misleading requests make this an easy escape. Reported only when the sandbox is on."
              },
              "help": {
                "text": "Set \"chat.agent.sandbox.allowUnsandboxedCommands\": false; such requests then fail instead of offering \"Allow Outside Sandbox\"."
              },
              "helpUri": "https://code.visualstudio.com/docs/agents/run/agent-sandboxing",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "sandbox-network",
                  "vscode-copilot",
                  "OWASP-ASI05",
                  "OWASP-ASI09"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-015",
              "name": "SandboxGrantsDeveloperToolAccess",
              "shortDescription": {
                "text": "Sandbox grants developer-tool access"
              },
              "fullDescription": {
                "text": "chat.agent.sandbox.fileSystem.allowDevToolAccess = true (default) gives sandboxed processes read access to tool directories on PATH, toolchains and developer-tool configuration and caches, which can include registry tokens, plus read/write access to shared build caches. Reported only when the sandbox is on."
              },
              "help": {
                "text": "Set \"chat.agent.sandbox.fileSystem.allowDevToolAccess\": false, then grant the few paths a build needs with \"readonlyPaths\"."
              },
              "helpUri": "https://code.visualstudio.com/docs/agents/run/agent-sandboxing",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "sandbox-network",
                  "vscode-copilot",
                  "OWASP-ASI03"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-016",
              "name": "CredentialsInjectedIntoTheSandbox",
              "shortDescription": {
                "text": "Credentials injected into the sandbox"
              },
              "fullDescription": {
                "text": "chat.agent.sandbox.credentials.authenticategit and authenticategh = true (defaults) give sandboxed processes your HTTPS Git credentials and your GitHub CLI account. The documentation warns that such a process can act with the permissions of the associated account: push code, open pull requests, read private repositories. Reported only when the sandbox is on."
              },
              "help": {
                "text": "Set \"chat.agent.sandbox.credentials.authenticategit\": false and \"chat.agent.sandbox.credentials.authenticategh\": false unless the task needs them; when it does, use a fine-grained, short-lived token."
              },
              "helpUri": "https://code.visualstudio.com/docs/agents/run/agent-sandboxing",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "sandbox-network",
                  "vscode-copilot",
                  "OWASP-ASI03"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-017",
              "name": "CredentialFoldersNotDeniedInTheSandbox",
              "shortDescription": {
                "text": "Credential folders not denied in the sandbox"
              },
              "fullDescription": {
                "text": "chat.agent.sandbox.fileSystem.userConfiguredPaths.deniedPaths does not list ~/.ssh, ~/.aws, ~/.azure or the GitHub CLI configuration (~/.config/gh, %APPDATA%\\GitHub CLI). deniedPaths takes precedence over every other grant, so listing them is cheap defense in depth. Severity is medium when developer-tool access is on, low otherwise. Reported only when the sandbox is on. Confidence is medium: whether the sandbox can read these folders by default, and whether ~ and environment variables are expanded, is not documented."
              },
              "help": {
                "text": "Add \"deniedPaths\": [\"~/.ssh\", \"~/.aws\", \"~/.azure\", \"~/.config/gh\", \"%APPDATA%/GitHub CLI\"] to chat.agent.sandbox.fileSystem.userConfiguredPaths (use absolute paths of the machine that runs the agent if ~ is not expanded)."
              },
              "helpUri": "https://code.visualstudio.com/docs/agents/run/agent-sandboxing",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "sandbox-network",
                  "vscode-copilot",
                  "OWASP-ASI03"
                ],
                "security-severity": "5.5",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-018",
              "name": "SandboxedCommandsAutoApprovedWithOpenNetwork",
              "shortDescription": {
                "text": "Sandboxed commands auto-approved with open network"
              },
              "fullDescription": {
                "text": "chat.agent.sandbox.allowAutoApprove = true (Local harness, default) auto-approves terminal commands that run inside the sandbox, while chat.agent.sandbox.network.allowNetwork = true leaves egress open: the sandbox is then the only barrier, and it does not stop data from leaving. Severity is medium when allowedDomains restricts destinations. Reported only when the sandbox is on. Confidence is medium: allowAutoApprove applies to the Local harness sandbox, whose Windows support is being retired, and its interaction with the network settings is not fully documented."
              },
              "help": {
                "text": "Set \"chat.agent.sandbox.allowAutoApprove\": false, or \"chat.agent.sandbox.network.allowNetwork\": false."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "sandbox-network",
                  "vscode-copilot",
                  "OWASP-ASI02",
                  "OWASP-ASI05"
                ],
                "security-severity": "8.0",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-019",
              "name": "ReadAccessOutsideTheWorkspace",
              "shortDescription": {
                "text": "Read access outside the workspace"
              },
              "fullDescription": {
                "text": "github.copilot.chat.additionalReadAccessFolders grants the built-in agent tools read-only access to folders outside the workspace. Anything there (keys, tokens, other projects) can be read and then leaked by an injected instruction. A drive root, the file system root or the home folder is high."
              },
              "help": {
                "text": "Set \"github.copilot.chat.additionalReadAccessFolders\": [], or list a few specific folders that hold no secrets."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "sandbox-network",
                  "vscode-copilot",
                  "OWASP-ASI03",
                  "OWASP-ASI02"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-020",
              "name": "HighAgentRequestLimit",
              "shortDescription": {
                "text": "High agent request limit"
              },
              "fullDescription": {
                "text": "chat.agent.maxRequests (default 25) is the number of requests the agent makes before it asks you to continue. A value above 100 lets a hijacked or looping agent run long chains of tool calls between human check-ins; 1000 or more is medium."
              },
              "help": {
                "text": "Keep \"chat.agent.maxRequests\" between 25 and 100, sized to the task."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "approvals",
                  "vscode-copilot",
                  "OWASP-ASI08",
                  "OWASP-ASI10"
                ],
                "security-severity": "3.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-021",
              "name": "MCPServerDiscoveryFromOtherApplications",
              "shortDescription": {
                "text": "MCP server discovery from other applications"
              },
              "fullDescription": {
                "text": "chat.mcp.discovery.enabled imports MCP server configurations from other applications (Claude Desktop, Copilot CLI, Cursor, Windsurf). Servers that were never reviewed for VS Code become available to the agent; VS Code only shows a trust dialog when such a server first starts or its configuration changes."
              },
              "help": {
                "text": "Set \"chat.mcp.discovery.enabled\": false and declare the servers you need explicitly in mcp.json after review."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/customization/mcp-servers",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "mcp-supply-chain",
                  "vscode-copilot",
                  "OWASP-ASI04"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-022",
              "name": "MCPServersStartAutomatically",
              "shortDescription": {
                "text": "MCP servers start automatically"
              },
              "fullDescription": {
                "text": "chat.mcp.autostart = \"newAndOutdated\" (default) or \"onlyNew\" starts MCP servers automatically when you send a chat message. Workspace servers (.vscode/mcp.json, .mcp.json) inherit Workspace Trust and start without a separate MCP prompt, so a new (or, with newAndOutdated, changed) server pulled with the repository runs code on the next message. Reported only when MCP servers are configured. Confidence is medium: the setting is Experimental."
              },
              "help": {
                "text": "Set \"chat.mcp.autostart\": \"never\" and start servers manually after reviewing configuration changes."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/customization/mcp-servers",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "mcp-supply-chain",
                  "vscode-copilot",
                  "OWASP-ASI04"
                ],
                "security-severity": "3.0",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-023",
              "name": "MCPServerPreAuthorizedForSampling",
              "shortDescription": {
                "text": "MCP server pre-authorized for sampling"
              },
              "fullDescription": {
                "text": "chat.mcp.serverSampling pre-authorizes MCP servers to request model completions (sampling) through your Copilot account. A malicious or compromised server can spend your quota and push its own prompts into a model call; a \"*\" model list is the widest grant. Confidence is medium: the value format is not described on the settings page."
              },
              "help": {
                "text": "Set \"chat.mcp.serverSampling\": {} unless a reviewed server needs sampling; then allow one specific model for that server only."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "mcp-supply-chain",
                  "vscode-copilot",
                  "OWASP-ASI04",
                  "OWASP-ASI02"
                ],
                "security-severity": "5.5",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-024",
              "name": "AgentOpenTelemetryDisabled",
              "shortDescription": {
                "text": "Agent OpenTelemetry disabled"
              },
              "fullDescription": {
                "text": "github.copilot.chat.otel.enabled = false (default): agent sessions, tool calls and model requests are not exported as OpenTelemetry traces, so there is no local audit trail to investigate an incident. Observability only, hence low."
              },
              "help": {
                "text": "Set \"github.copilot.chat.otel.enabled\": true with \"github.copilot.chat.otel.otlpEndpoint\" pointing to a local or approved collector."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
