                ],
                "security-severity": "3.0",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-025",
              "name": "PromptContentCapturedInTelemetry",
              "shortDescription": {
                "text": "Prompt content captured in telemetry"
              },
              "fullDescription": {
                "text": "github.copilot.chat.otel.captureContent = true, with OpenTelemetry enabled, puts full prompts, responses and tool data in spans; the settings page warns that they may include sensitive information such as secrets and personal data. Severity is high when the OTLP collector is not on the local machine."
              },
              "help": {
                "text": "Set \"github.copilot.chat.otel.captureContent\": false outside an isolated test environment, and keep \"github.copilot.chat.otel.otlpEndpoint\" on localhost."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/reference/copilot-settings",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "secrets",
                  "vscode-copilot",
                  "OWASP-ASI03"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            },
            {
              "id": "AW-VSC-026",
              "name": "WorkspaceTrustDisabled",
              "shortDescription": {
                "text": "Workspace Trust disabled"
              },
              "fullDescription": {
                "text": "security.workspace.trust.enabled = false turns off Workspace Trust. Restricted Mode normally disables agents in an untrusted folder and blocks its workspace MCP servers and hook files until you trust it; without it, the agent configuration of a freshly cloned repository is live at once. Confidence is medium: whether VS Code honors this setting at workspace scope is not documented."
              },
              "help": {
                "text": "Remove the setting or set \"security.workspace.trust.enabled\": true (the default). Open unknown repositories in Restricted Mode and trust them only after reviewing their agent configuration."
              },
              "helpUri": "https://code.visualstudio.com/docs/editing/workspaces/workspace-trust",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "mcp-supply-chain",
                  "vscode-copilot",
                  "OWASP-ASI04"
                ],
                "security-severity": "8.0",
                "precision": "medium"
              }
            },
            {
              "id": "AW-VSC-027",
              "name": "RepositoryHookFileRunsInTheLocalHarness",
              "shortDescription": {
                "text": "Repository hook file runs in the Local harness"
              },
              "fullDescription": {
                "text": "chat.useHooks = true (default) makes the Local harness run the commands of workspace hook files (.github/hooks/*.json, and .claude/settings*.json when chat.useClaudeHooks is on) with your rights. Hooks are executable code: a repository can plant one that runs on agent events as soon as the folder is trusted, a supply-chain risk. Severity is high when Workspace Trust is disabled."
              },
              "help": {
                "text": "Review every hook file and the scripts it calls, protect them with CODEOWNERS and \"**/.github/hooks/**\": false in chat.tools.edits.autoApprove, or set \"chat.useHooks\": false where repository hooks are not needed."
              },
              "helpUri": "https://code.visualstudio.com/docs/copilot/customization/hooks",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "mcp-supply-chain",
                  "vscode-copilot",
                  "OWASP-ASI04",
                  "OWASP-ASI05"
                ],
                "security-severity": "5.5",
                "precision": "high"
              }
            }
          ]
        }
