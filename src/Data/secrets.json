// Rule data for src/Rules/Secrets.ps1 (AW-SEC rules), read with ConvertFrom-AwJsonc.
// Provider formats only: no secret, URL or payload (CONTRIBUTING.md, Antivirus hygiene).
// Each pattern captures the secret in the group 'v'. It starts at a token boundary (lookbehind) and
// uses bounded or atomic quantifiers, so that a scan stays linear (ReDoS-safe).
// mask: the value is masked in evidence (false: only the matched header is shown).
// needsDigit: a match without a digit and a letter is dropped (hyphenated words such as sk-learn-...).
{
  "providers": [
    { "ruleId": "AW-SEC-001", "name": "GitHub token", "mask": true, "needsDigit": false, "caseSensitive": true,
      "pattern": "(?<![A-Za-z0-9_])(?<v>(?:ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]{36,251}|ghs_[0-9]{1,20}_eyJ[A-Za-z0-9_.-]{20,8000}|github_pat_[A-Za-z0-9_]{60,251})(?![A-Za-z0-9_])" },
    { "ruleId": "AW-SEC-002", "name": "AWS access key ID", "mask": true, "needsDigit": false, "caseSensitive": true,
      "pattern": "(?<![A-Za-z0-9])(?<v>(?:AKIA|ASIA)[A-Z0-9]{16})(?![A-Za-z0-9])" },
    { "ruleId": "AW-SEC-003", "name": "Azure Storage account key", "mask": true, "needsDigit": false, "caseSensitive": false,
      "pattern": "(?<![A-Za-z0-9])AccountKey[ \\t]*=[ \\t]*(?<v>[A-Za-z0-9+/]{30,200}={0,2})" },
    { "ruleId": "AW-SEC-004", "name": "OpenAI-style API key", "mask": true, "needsDigit": true, "caseSensitive": true,
      "pattern": "(?<![A-Za-z0-9_-])(?<v>sk-(?!ant-)(?:proj-|svcacct-|admin-)?[A-Za-z0-9_-]{20,400})(?![A-Za-z0-9_-])" },
    { "ruleId": "AW-SEC-005", "name": "Anthropic API key", "mask": true, "needsDigit": true, "caseSensitive": true,
      "pattern": "(?<![A-Za-z0-9_-])(?<v>sk-ant-[A-Za-z0-9_-]{20,400})(?![A-Za-z0-9_-])" },
    { "ruleId": "AW-SEC-006", "name": "Slack token", "mask": true, "needsDigit": true, "caseSensitive": true,
      "pattern": "(?<![A-Za-z0-9-])(?<v>xox[baprs]-[A-Za-z0-9-]{10,250})(?![A-Za-z0-9-])" },
    { "ruleId": "AW-SEC-007", "name": "Private key block", "mask": false, "needsDigit": false, "caseSensitive": true,
      "pattern": "(?<v>-----BEGIN[ A-Z0-9]{0,40}PRIVATE KEY(?: BLOCK)?-----)" },
    { "ruleId": "AW-SEC-008", "name": "JSON Web Token", "mask": true, "needsDigit": false, "caseSensitive": true,
      "pattern": "(?<![A-Za-z0-9_-])(?<v>eyJ(?>[A-Za-z0-9_-]{8,4000})\\.eyJ(?>[A-Za-z0-9_-]{8,8000})\\.(?>[A-Za-z0-9_-]{10,4000}))(?![A-Za-z0-9_-])" }
  ]
}
