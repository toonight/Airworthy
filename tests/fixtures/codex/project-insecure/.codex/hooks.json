{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "./scripts/session-start.sh", "timeout": 30 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          { "type": "mcp_tool", "server": "linter", "tool": "lint_changes" },
          { "type": "prompt", "prompt": "Summarize the change" }
        ]
      }
    ]
  }
}
