// Synthetic CLEAN fixture: secrets are prompted or referenced, never written.
{
  "inputs": [
    { "type": "promptString", "id": "gh-token", "description": "GitHub token", "password": true }
  ],
  "servers": {
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@example/mcp-github@1.0.0"],
      "env": {
        "GITHUB_TOKEN": "${input:gh-token}",
        "API_KEY": "${env:API_KEY}",
        "DB_PASSWORD": "$DB_PASSWORD",
        "SERVICE_TOKEN": "%SERVICE_TOKEN%"
      }
    }
  }
}
